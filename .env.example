# ==============================================================================
# VyapaarSetu Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values.
# NEVER commit real production secrets, passwords, or API keys to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=VyapaarSetu
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & JWT Authentication
# In production, generate a secure 64-char key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_production_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vyapaarsetu_db

# Complete Database Async URL (SQLAlchemy + asyncpg)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_database_password@127.0.0.1:5432/vyapaarsetu_db

# CORS Configuration (comma-separated origins allowed to make API requests)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Provider Configuration ("auto", "gemini", or "openai")
AI_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# OpenAI API (Optional Fallback / Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=15

# SMS / OTP Gateway Configuration (Optional - Defaults to development MockSMSProvider)
# When FAST2SMS_API_KEY is provided, LiveFast2SMSProvider is activated.
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Business Logic & Scheme Policies
# Stacking Policy: FLAG_CONFLICT_FOR_REVIEW (safe default), BEST_VALUE, or ALLOW_STACKING
ALLOW_SCHEME_STACKING=False
SCHEME_STACKING_POLICY=FLAG_CONFLICT_FOR_REVIEW

# Credit & Stock Policies
STRICT_CREDIT_HOLD=True
INSUFFICIENT_STOCK_POLICY=REJECT_ORDER

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite client-side only - prefixed with VITE_)
# NEVER put private server keys, database passwords, or secret tokens here.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=VyapaarSetu
