# Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL ONLY)
DATABASE_URL=postgresql+asyncpg://vyapaar_user:vyapaar_password@localhost:5432/vyapaarsetu_db
SYNC_DATABASE_URL=postgresql://vyapaar_user:vyapaar_password@localhost:5432/vyapaarsetu_db

# Security & JWT
SECRET_KEY=generate_a_secure_random_key_for_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Distributor Details (Company A - Jabalpur)
DISTRIBUTOR_NAME=Company A
DISTRIBUTOR_CITY=Jabalpur
DISTRIBUTOR_STATE=Madhya Pradesh
DISTRIBUTOR_GSTIN=23AAAAA0000A1Z5

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

